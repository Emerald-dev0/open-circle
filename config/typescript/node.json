{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.cache/typescript/node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["../../vite.config.ts", "../../server/vite-dev-api.ts", "../../server/vite-seo.ts", "../../shared/brand.ts", "../../scripts", "../../neon.ts"]
}
