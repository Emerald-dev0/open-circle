# GitHub token used for read-only GraphQL lookups of public profiles.
# A fine-grained token with no repository access is enough (public data only).
GITHUB_TOKEN=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth-callback

# Comma-separated immutable GitHub user IDs allowed to sign in at /admin.
# Requires the GitHub OAuth configuration above. Empty or invalid IDs disable admin.
ADMIN_GITHUB_IDS=

# Node hosts only: enable when running behind a trusted reverse proxy.
TRUST_PROXY=0

WHATSAPP_MEMBERSHIP_URL=
WHATSAPP_MEMBERSHIP_TOKEN=

# Neon Postgres. The app uses the pooled URL; migrations require the direct URL.
# Pull both with npx neon@latest deploy after linking the project.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional legacy Upstash Redis. Used only when DATABASE_URL is unset.
# Without either database, local dev keeps data in .data/dev-store.json.
# Vercel's integration may name these KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

KV_REST_API_URL=
KV_REST_API_TOKEN=

PORTFOLIO_SUBDOMAINS_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

WHATSAPP_ADMIN_TOKEN=
