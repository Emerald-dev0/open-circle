# GitHub token used for read-only GraphQL lookups of public profiles.
# A fine-grained token with no repository access is enough (public data only).
GITHUB_TOKEN=

# Shared secret for /admin. Use something long and random.
ADMIN_SECRET=

# Upstash Redis (Vercel Marketplace → Upstash). Required in production;
# without it, local dev keeps data in .data/dev-store.json.
# Vercel's integration may name these KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
